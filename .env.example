# Copy this file to .env and fill in the required values. Never commit .env.
SPOTIFY_BASE_URL=https://api.spotify.com/v1
SPOTIFY_TOKEN_URL=https://accounts.spotify.com/api/token

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_ARTIST_ID=
# Optional format: BANDID_ARTISTID1:ARTISTID2,BANDID_ARTISTID1:ARTISTID2
SPOTIFY_ARTIST_BAND_IDS=

LINKTREE_URL=

# Local development values. Docker Compose overrides REDIS_HOST for the backend.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Set a non-empty strong password before running Redis / Docker Compose.
REDIS_PASSWORD=
BACKEND_PORT=3000
